                <mxCell id="p2-e2" edge="1" parent="p2-1" source="p2-home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=1.5;endArrow=block;fontSize=10;exitX=0.3;exitY=1;entryX=0.5;entryY=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="p2-prefs" value="toggles serviceEnabled">
