                <mxCell id="p2-gw" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontSize=11;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#065F46;&quot;&gt;GatewaysFragment&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:10px;color:#064E3B;text-align:left;&quot;&gt;• Add/Edit/Delete gateways&lt;br/&gt;• Per-gateway toggle&lt;br/&gt;• &quot;Test Connection&quot; action&lt;/div&gt;" vertex="1">
                    <mxGeometry height="105" width="180" x="660" y="125" as="geometry"/>
                </mxCell>
                <mxCell id="p2-logs" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontSize=11;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#065F46;&quot;&gt;LogsFragment&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:10px;color:#064E3B;text-align:left;&quot;&gt;• Real-time Log RecyclerView&lt;br/&gt;• Search filter &amp; clear&lt;br/&gt;• Sent / Failed tags&lt;/div&gt;" vertex="1">
                    <mxGeometry height="105" width="180" x="870" y="125" as="geometry"/>
                </mxCell>
                <mxCell id="p2-set" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontSize=11;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#065F46;&quot;&gt;SettingsFragment&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:10px;color:#064E3B;text-align:left;&quot;&gt;• Polling frequency config&lt;br/&gt;• SIM preference setting&lt;br/&gt;• Dark / Light Theme picker&lt;/div&gt;" vertex="1">
                    <mxGeometry height="105" width="180" x="1080" y="125" as="geometry"/>
                </mxCell>
                <mxCell id="p2-tier2" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#1E293B;&quot;&gt;LAYER 2: STATE MANAGEMENT &amp; LOCAL PERSISTENCE&lt;/b&gt;" vertex="1">
                    <mxGeometry height="130" width="1240" x="40" y="270" as="geometry"/>
                </mxCell>
                <mxCell id="p2-prefs" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#92400E;font-size:12px;&quot;&gt;Prefs (EncryptedSharedPreferences)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#78350F;text-align:left;&quot;&gt;• &lt;b&gt;backends&lt;/b&gt;: JSON list of configured gateways (URL, Token, SIM, Enabled)&lt;br/&gt;• &lt;b&gt;service_enabled&lt;/b&gt;: Boolean master state flag&lt;br/&gt;• &lt;b&gt;sent_count&lt;/b&gt; &amp; &lt;b&gt;failed_count&lt;/b&gt;: Persistent transmission counters&lt;br/&gt;• &lt;b&gt;queued_statuses_{id}&lt;/b&gt;: Per-backend offline retry queue for delivery reports&lt;/div&gt;" vertex="1">
                    <mxGeometry height="80" width="670" x="60" y="305" as="geometry"/>
                </mxCell>
                <mxCell id="p2-logstore" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#92400E;font-size:12px;&quot;&gt;LogStore (Circular Memory &amp; Prefs Store)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#78350F;text-align:left;&quot;&gt;• Thread-safe synchronized buffer of the last 50 gateway events&lt;br/&gt;• Emits updates directly to LogsFragment UI and audit timeline&lt;/div&gt;" vertex="1">
                    <mxGeometry height="80" width="500" x="760" y="305" as="geometry"/>
                </mxCell>
                <mxCell id="p2-tier3" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#1E293B;&quot;&gt;LAYER 3: BACKGROUND ORCHESTRATION &amp; LIFECYCLE&lt;/b&gt;" vertex="1">
                    <mxGeometry height="150" width="1240" x="40" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="p2-svc" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#065F46;font-size:12px;&quot;&gt;SmsForegroundService (Primary Engine)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#064E3B;text-align:left;&quot;&gt;• Foreground service with persistent status notification&lt;br/&gt;• 15-second coroutine polling ticker per enabled gateway&lt;br/&gt;• Exponential backoff (30s / 60s) on network failures&lt;br/&gt;• Flushes pending offline status callbacks before polling&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="450" x="60" y="455" as="geometry"/>
                </mxCell>
                <mxCell id="p2-worker" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#5B21B6;font-size:12px;&quot;&gt;SmsPollWorker (WorkManager Fallback)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#4C1D95;text-align:left;&quot;&gt;• Periodic 15-minute scheduled fallback job&lt;br/&gt;• Automatically skipped if Foreground Service is alive&lt;br/&gt;• Skips immediately if &lt;code&gt;service_enabled == false&lt;/code&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="370" x="540" y="455" as="geometry"/>
                </mxCell>
                <mxCell id="p2-boot" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;strokeWidth=1.5;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#9F1239;font-size:12px;&quot;&gt;BootReceiver&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#881337;text-align:left;&quot;&gt;• Catches &lt;code&gt;ACTION_BOOT_COMPLETED&lt;/code&gt;&lt;br/&gt;• Reads &lt;code&gt;Prefs.service_enabled&lt;/code&gt;&lt;br/&gt;• Restarts Foreground Service only if ON&lt;br/&gt;• Cancels stale workers if OFF&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="320" x="940" y="455" as="geometry"/>
                </mxCell>
                <mxCell id="p2-tier4" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#1E293B;&quot;&gt;LAYER 4: NETWORK CLIENT &amp; HARDWARE DISPATCH&lt;/b&gt;" vertex="1">
                    <mxGeometry height="160" width="1240" x="40" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="p2-api" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#1E40AF;font-size:12px;&quot;&gt;ApiClient (Retrofit + Moshi)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#1E3A8A;text-align:left;&quot;&gt;• Per-gateway base URL &amp; Bearer token header&lt;br/&gt;• &lt;b&gt;getPending(limit)&lt;/b&gt;: Pulls queued SMS items&lt;br/&gt;• &lt;b&gt;postStatus(report)&lt;/b&gt;: Syncs delivery outcomes&lt;/div&gt;" vertex="1">
                    <mxGeometry height="105" width="340" x="60" y="625" as="geometry"/>
                </mxCell>
                <mxCell id="p2-sender" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#115E59;font-size:12px;&quot;&gt;SmsSender (Dual-SIM &amp; SmsManager)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#134E4A;text-align:left;&quot;&gt;• Selects SIM 1 / SIM 2 subscription ID (Android 12+ API 31 safe)&lt;br/&gt;• Auto multipart split &amp; PendingIntent tracking&lt;br/&gt;• Maps carrier errors (NO_SERVICE, RADIO_OFF, LIMIT_EXCEEDED)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="105" width="430" x="440" y="625" as="geometry"/>
                </mxCell>
                <mxCell id="p2-cb" parent="p2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;color:#C2410C;font-size:12px;&quot;&gt;Sent &amp; Delivered Receivers&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#9A3412;text-align:left;&quot;&gt;• SentReceiver: Confirms cellular tower ACK&lt;br/&gt;• DeliveredReceiver: Confirms handset receipt&lt;br/&gt;• Pushes result to LogStore &amp; ApiClient&lt;/div&gt;" vertex="1">
                    <mxGeometry height="105" width="350" x="910" y="625" as="geometry"/>
                </mxCell>
                <mxCell id="p2-e1" edge="1" parent="p2-1" source="p2-app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="p2-main" value="launches">
