                </mxCell>
                <mxCell id="p1-erp" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#312E81;&quot;&gt;Backend / ERP System&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;border-color:#C7D2FE;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#374151;line-height:1.4;&quot;&gt;• E-Commerce, Auth, CRM&lt;br/&gt;• Generates OTPs &amp; Alerts&lt;br/&gt;• Sends HTTP JSON payload&lt;br/&gt;• Header: &lt;code&gt;Bearer token&lt;/code&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="210" x="65" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="p1-audit" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Web Dashboard / Audit UI&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;border-color:#CBD5E1;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#475569;line-height:1.4;&quot;&gt;• Delivery logs &amp; timestamps&lt;br/&gt;• Queue depth &amp; latency&lt;br/&gt;• Gateway health monitoring&lt;br/&gt;• Failed message inspection&lt;/div&gt;" vertex="1">
