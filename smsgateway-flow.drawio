                <mxCell id="p2-e3" edge="1" parent="p2-1" source="p2-home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;fontSize=10;fontColor=#16A34A;fontStyle=1;exitX=0.7;exitY=1;entryX=0.6;entryY=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="p2-svc" value="startService() / stopService()">
