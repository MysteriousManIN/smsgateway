    <diagram name="3 - Service ON-OFF Lifecycle" id="page-lifecycle">
        <mxGraphModel dx="1591" dy="1101" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="p3-0"/>
                <mxCell id="p3-1" parent="p3-0"/>
                <mxCell id="p3-title" parent="p3-1" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0F172A;fillColor=none;strokeColor=none;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Service ON / OFF Lifecycle &amp; Boot Recovery" vertex="1">
                    <mxGeometry height="30" width="800" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="p3-subtitle" parent="p3-1" style="text;html=1;fontSize=12;fontColor=#64748B;fillColor=none;strokeColor=none;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="State transitions • Coroutine lifecycle management • WorkManager fallback • Device reboot recovery" vertex="1">
                    <mxGeometry height="20" width="800" x="40" y="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3-start" parent="p3-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;User Toggles Service Control&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#475569;&quot;&gt;Via Home switch, Settings switch, or Notification &quot;Stop&quot; action&lt;/div&gt;" vertex="1">
                    <mxGeometry height="70" width="340" x="320" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3-decide" parent="p3-1" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontSize=12;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Is Switch&lt;br/&gt;ON or OFF?&lt;/b&gt;" vertex="1">
                    <mxGeometry height="110" width="200" x="390" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="p3-on" parent="p3-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;verticalAlign=top;spacingTop=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#065F46;&quot;&gt;Service Switched ON (serviceEnabled = true)&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;border-color:#A7F3D0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#064E3B;line-height:1.45;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Persist &lt;code&gt;service_enabled = true&lt;/code&gt; to EncryptedSharedPreferences&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; Start &lt;code&gt;SmsForegroundService&lt;/code&gt; with persistent status notification&lt;br/&gt;&lt;b&gt;3.&lt;/b&gt; Launch 15s coroutine polling loop per enabled gateway&lt;br/&gt;&lt;b&gt;4.&lt;/b&gt; Schedule &lt;code&gt;SmsPollWorker&lt;/code&gt; (15-min fallback) via WorkManager&lt;br/&gt;&lt;b&gt;5.&lt;/b&gt; Update UI stats &amp; notification status text to &quot;Running&quot;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="410" x="60" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="p3-off" parent="p3-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;verticalAlign=top;spacingTop=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#9F1239;&quot;&gt;Service Switched OFF (serviceEnabled = false)&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;border-color:#FECDD3;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#881337;line-height:1.45;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Persist &lt;code&gt;service_enabled = false&lt;/code&gt; to EncryptedSharedPreferences&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; Call &lt;code&gt;stopForeground(STOP_FOREGROUND_REMOVE)&lt;/code&gt; &amp; &lt;code&gt;stopSelf()&lt;/code&gt;&lt;br/&gt;&lt;b&gt;3.&lt;/b&gt; Cancel all active coroutines &amp; in-flight HTTP requests immediately&lt;br/&gt;&lt;b&gt;4.&lt;/b&gt; Cancel periodic &lt;code&gt;SmsPollWorker&lt;/code&gt; via &lt;code&gt;WorkManager.cancel()&lt;/code&gt;&lt;br/&gt;&lt;b&gt;5.&lt;/b&gt; Notification dismissed • Zero background battery consumption&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="410" x="510" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="p3-reboot-container" parent="p3-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#1E293B;&quot;&gt;DEVICE REBOOT RECOVERY LIFECYCLE (BootReceiver)&lt;/b&gt;" vertex="1">
                    <mxGeometry height="140" width="860" x="60" y="530" as="geometry"/>
                </mxCell>
