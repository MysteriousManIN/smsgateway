                <mxCell id="p2-e6" edge="1" parent="p2-1" source="p2-svc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#2563EB;fontStyle=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="p2-api" value="GET /pending">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-e7" edge="1" parent="p2-1" source="p2-svc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#0D9488;fontStyle=1;exitX=0.75;exitY=1;entryX=0.35;entryY=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="p2-sender" value="dispatch SMS batch">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-e8" edge="1" parent="p2-1" source="p2-sender" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EA580C;strokeWidth=1.5;endArrow=block;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="p2-cb" value="carrier intents">
