                <mxCell id="p1-col2" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#1E293B;&quot;&gt;2. CENTRAL GATEWAY SERVER&lt;/b&gt;" vertex="1">
                    <mxGeometry height="580" width="310" x="340" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="p1-api" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#1E3A8A;&quot;&gt;Gateway REST API Server&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;border-color:#BFDBFE;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#1E293B;line-height:1.45;&quot;&gt;• &lt;b&gt;POST /send&lt;/b&gt; — Enqueue SMS&lt;br/&gt;• &lt;b&gt;GET /pending?limit=10&lt;/b&gt; — Agent poll&lt;br/&gt;• &lt;b&gt;POST /status&lt;/b&gt; — Delivery reports&lt;br/&gt;• &lt;b&gt;GET /logs&lt;/b&gt; — History &amp; metrics&lt;br/&gt;&lt;span style=&quot;color:#2563EB;&quot;&gt;• Bearer Auth &amp; Rate Limiter&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="180" width="270" x="360" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="p1-db" parent="p1-1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#5B21B6;&quot;&gt;PostgreSQL Database&lt;/b&gt;&lt;br/&gt;&lt;code style=&quot;font-size:11px;&quot;&gt;table: sms_queue&lt;/code&gt;&lt;hr style=&quot;margin:6px 0;border-color:#DDD6FE;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#4C1D95;line-height:1.4;&quot;&gt;• Status: &lt;i&gt;pending | sent | delivered | failed&lt;/i&gt;&lt;br/&gt;• Target phone number &amp; text body&lt;br/&gt;• Assigned gateway ID &amp; SIM slot&lt;br/&gt;• ACID transaction locks&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="240" x="375" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="p1-col3" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4ADE80;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#1E293B;&quot;&gt;3. ANDROID GATEWAY AGENT (Physical Mobile Device)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#475569;font-weight:normal;&quot;&gt;HTTP Client Only • Works behind NAT / Wi-Fi / 4G • No Public IP or Open Inbound Ports required&lt;/span&gt;" vertex="1">
                    <mxGeometry height="580" width="460" x="690" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="p1-fgs" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:12px;color:#065F46;&quot;&gt;Step 1: SmsForegroundService (Polling Loop)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border-color:#A7F3D0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#064E3B;line-height:1.35;&quot;&gt;• Polls enabled gateways every 15 seconds via Kotlin Coroutines&lt;br/&gt;• Exponential backoff (30s / 60s) on network disconnection&lt;br/&gt;• Foreground notification keeps process immune to OEM background killers&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="410" x="715" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="p1-mgr" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:12px;color:#115E59;&quot;&gt;Step 2: SmsManager &amp; Dual-SIM Dispatcher&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border-color:#99F6E4;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#134E4A;line-height:1.35;&quot;&gt;• Routes via designated SIM card (SubscriptionManager slot ID)&lt;br/&gt;• Auto multipart segmentation if text exceeds 160 GSM-7 / 70 UCS-2 chars&lt;br/&gt;• 500ms safety rate pacing between dispatches to prevent carrier blocking&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="410" x="715" y="285" as="geometry"/>
                </mxCell>
                <mxCell id="p1-cb" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:12px;color:#92400E;&quot;&gt;Step 3: Broadcast Receivers &amp; Status Reporter&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border-color:#FDE68A;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#78350F;line-height:1.35;&quot;&gt;• &lt;b&gt;SentReceiver&lt;/b&gt;: Traps RESULT_OK, NO_SERVICE, RADIO_OFF, LIMIT_EXCEEDED&lt;br/&gt;• &lt;b&gt;DeliveredReceiver&lt;/b&gt;: Traps carrier PDU SMS-STATUS-REPORT delivery receipt&lt;br/&gt;• Local offline retry buffer: Persists status in Prefs if connection momentarily drops&lt;/div&gt;" vertex="1">
                    <mxGeometry height="105" width="410" x="715" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="p1-col4" parent="p1-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&quot;font-size:13px;color:#1E293B;&quot;&gt;4. TELECOM &amp; RECIPIENTS&lt;/b&gt;" vertex="1">
