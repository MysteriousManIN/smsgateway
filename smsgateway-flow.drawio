<mxfile host="app.diagrams.net">
  <diagram name="1 - System End-to-End Flow" id="page-system">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="p1-0" />
        <mxCell id="p1-1" parent="p1-0" />
        <mxCell id="p1-title" value="SMS Gateway — End-to-End Working Flow" style="text;html=1;fontSize=22;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-erp" value="Backend / Application Server&#10;(enqueue SMS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontSize=13;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="120" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1-api" value="Backend REST API&#10;• POST /send&#10;• GET /pending&#10;• POST /status&#10;• GET /logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#B45309;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="p1-1">
          <mxGeometry x="300" y="100" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-db" value="sms_queue&#10;(postgres)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="p1-1">
          <mxGeometry x="590" y="110" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-audit" value="Audit UI / Dashboard&#10;(delivery logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FB;strokeColor=#64748B;fontSize=12;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-phone" value="Android Phone (SIM + App)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FB;strokeColor=#0F172A;strokeWidth=2;fontSize=14;fontStyle=1;align=left;spacingLeft=16;spacingTop=-380;" vertex="1" parent="p1-1">
          <mxGeometry x="830" y="60" width="500" height="460" as="geometry" />
        </mxCell>
        <mxCell id="p1-fgs" value="SmsForegroundService&#10;poll every 15s per enabled gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontSize=12;" vertex="1" parent="p1-1">
          <mxGeometry x="860" y="130" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-mgr" value="SmsManager.sendTextMessage()&#10;(auto multipart if &gt; 160 chars)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="p1-1">
          <mxGeometry x="860" y="230" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-cb" value="Sent / Delivered receivers&#10;→ POST /status (sent, failed, delivered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;fontSize=12;" vertex="1" parent="p1-1">
          <mxGeometry x="860" y="330" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-note" value="Phone = HTTP client only — no public IP / port forwarding needed (works behind CGNAT, Wi-Fi, mobile data)" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;fontColor=#64748B;" vertex="1" parent="p1-1">
          <mxGeometry x="860" y="420" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-e1" value="POST /send&#10;Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p1-1" source="p1-erp" target="p1-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e2" value="insert pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p1-1" source="p1-api" target="p1-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e3" value="GET /pending?limit=10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="p1-1" source="p1-fgs" target="p1-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e4" value="dispatch each msg&#10;(500ms gap)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p1-1" source="p1-fgs" target="p1-mgr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e5" value="carrier result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p1-1" source="p1-mgr" target="p1-cb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e6" value="POST /status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="p1-1" source="p1-cb" target="p1-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e7" value="GET /logs&#10;(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="p1-1" source="p1-audit" target="p1-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 - Android App Internal Flow" id="page-app">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-title" value="Android App — Internal Working Flow" style="text;html=1;fontSize=22;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-app" value="App.kt&#10;(launch + theme)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FB;strokeColor=#0F172A;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="90" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-main" value="MainActivity&#10;(drawer + 4 tabs, permissions,&#10;battery exemption, offline banner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="290" y="80" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-prefs" value="Prefs&#10;(EncryptedSharedPreferences)&#10;• backend list&#10;• service_enabled flag&#10;• sent / failed counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#B45309;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="p2-1">
          <mxGeometry x="830" y="70" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-api" value="ApiClient&#10;(Retrofit + Moshi per gateway,&#10;Bearer interceptor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#B45309;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="830" y="230" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-home" value="Home&#10;(stats + Start/Stop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="240" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-gw" value="Gateways&#10;(add / edit / delete&#10;toggle / test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="230" y="240" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-logs" value="Logs&#10;(LogStore last 50,&#10;search + clear)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="420" y="240" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-set" value="Settings&#10;(service switch, battery,&#10;theme, polling info)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="610" y="240" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-svc" value="SmsForegroundService&#10;(pollingLoop 15s, backoff 30/60s,&#10;per-gateway isolation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="230" y="390" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-worker" value="SmsPollWorker&#10;(WorkManager 15-min&#10;fallback, skips if FGS running&#10;or service OFF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="540" y="390" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-boot" value="BootReceiver&#10;(restart only if&#10;serviceEnabled = ON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="830" y="390" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-sender" value="SmsSender&#10;(SmsManager + sent/delivered&#10;receivers, error mapping)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="230" y="550" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-sim" value="SIM / Carrier&#10;(sent → delivered&#10;best-effort receipt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FB;strokeColor=#64748B;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="540" y="550" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-done" value="POST /status → LogStore + counters&#10;(sent / failed / delivered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="230" y="700" width="570" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;" edge="1" parent="p2-1" source="p2-app" target="p2-main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" value="hosts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p2-1" source="p2-main" target="p2-home">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" value="gateway CRUD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p2-1" source="p2-gw" target="p2-prefs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" value="Start / Stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="p2-1" source="p2-home" target="p2-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" value="GET pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B45309;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="p2-1" source="p2-svc" target="p2-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" value="GET pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="p2-1" source="p2-worker" target="p2-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e7" value="send each msg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p2-1" source="p2-svc" target="p2-sender">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" value="send each msg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p2-1" source="p2-worker" target="p2-sender">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e9" value="via SIM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;fontSize=11;" edge="1" parent="p2-1" source="p2-sender" target="p2-sim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e10" value="report result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="p2-1" source="p2-sender" target="p2-done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e11" value="reboot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E11D48;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="p2-1" source="p2-boot" target="p2-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 - Service ON-OFF Lifecycle" id="page-lifecycle">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />
        <mxCell id="p3-title" value="Service ON / OFF Lifecycle (incl. Reboot)" style="text;html=1;fontSize=22;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-start" value="User toggles Service Controls&#10;(Home / Settings / notification Stop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FB;strokeColor=#0F172A;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="300" y="90" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-decide" value="ON or OFF?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;fontSize=13;" vertex="1" parent="p3-1">
          <mxGeometry x="350" y="200" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-on" value="serviceEnabled = true&#10;FGS starts polling 15s&#10;Worker = standby fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="80" y="380" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-off" value="serviceEnabled = false&#10;FGS stops, Worker cancelled&#10;no polling, no SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="540" y="380" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-reboot" value="Device reboot / update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FB;strokeColor=#0F172A;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="310" y="510" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;endArrow=block;" edge="1" parent="p3-1" source="p3-start" target="p3-decide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" value="ON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#047857;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-decide" target="p3-on">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e3" value="OFF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E11D48;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-decide" target="p3-off">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e4" value="BootReceiver: flag ON → restart FGS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#047857;endArrow=block;fontSize=11;" edge="1" parent="p3-1" source="p3-on" target="p3-reboot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e5" value="BootReceiver: flag OFF → skip, cancel stale Worker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E11D48;endArrow=block;fontSize=11;" edge="1" parent="p3-1" source="p3-off" target="p3-reboot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
