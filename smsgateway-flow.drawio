                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-e5" edge="1" parent="p2-1" source="p2-logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.5;dashed=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="p2-logstore" value="observes events">
                    <mxGeometry relative="1" as="geometry"/>
