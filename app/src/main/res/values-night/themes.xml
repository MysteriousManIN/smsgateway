<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark gray: light status/nav icons on dark bars -->
    <style name="Theme.SmsGateway" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accentBlueLight</item>
        <item name="colorOnPrimaryContainer">@color/text_dark</item>
        <item name="colorSecondary">@color/primary_accent</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- windowLightNavigationBar (v27+) and forceDarkAllowed (v29+)
             live in values-night-v27 / values-night-v29 overlays (minSdk 24) -->
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>
        <!-- monochrome editorial — Italiana display, DM Sans body -->
    </style>
</resources>
