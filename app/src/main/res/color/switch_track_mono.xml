<?xml version="1.0" encoding="utf-8"?>
<!-- ponytail: monochrome track — on #111 black visible, off #E9ECEF grey visible, fixes invisible track when checked -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/text_dark" android:state_checked="true" />
    <item android:color="@color/border" />
</selector>
