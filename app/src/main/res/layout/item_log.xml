<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="4dp"
    android:gravity="center_vertical">

    <!-- Monochrome dot -->
    <View
        android:id="@+id/dotTimeline"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_timeline_dot_mono"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp" />

    <!-- Timeline line hidden but keep id for compat -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@drawable/bg_timeline_line" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border"
        app:cardBackgroundColor="@color/white">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/figtree"
            android:padding="12dp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="now"
        android:textSize="9sp"
        android:textColor="@color/text_muted"
        android:fontFamily="@font/figtree"
        android:layout_marginStart="8dp"
        android:layout_gravity="center_vertical"
        android:visibility="gone" />
</LinearLayout>
