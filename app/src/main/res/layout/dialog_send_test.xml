<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send Test SMS / RCS"
        android:textSize="24sp"
        android:textColor="@color/text_dark"
        android:fontFamily="@font/italiana_regular"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dispatch a live message through active SIM"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:fontFamily="@font/dm_sans"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Recipient Phone (+91... or 10 digits)"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/border"
        app:hintTextColor="@color/text_muted"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTestPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="phone"
            android:fontFamily="@font/dm_sans"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Message Content"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/border"
        app:hintTextColor="@color/text_muted"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTestMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="4"
            android:text="Test dispatch from Sandesh Gateway"
            android:fontFamily="@font/dm_sans"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Channel / Routing"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:fontFamily="@font/dm_sans"
        android:layout_marginBottom="6dp" />

    <RadioGroup
        android:id="@+id/rgChannel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbChannelSms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Normal SMS"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/dm_sans" />

        <RadioButton
            android:id="@+id/rbChannelRcs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RCS Fallback"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/dm_sans" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_dark"
            app:strokeColor="@color/border"
            app:cornerRadius="0dp"
            android:fontFamily="@font/dm_sans" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestSend"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Send Now"
            android:textColor="@color/white"
            app:backgroundTint="@color/text_dark"
            app:cornerRadius="0dp"
            android:fontFamily="@font/dm_sans" />
    </LinearLayout>
</LinearLayout>

