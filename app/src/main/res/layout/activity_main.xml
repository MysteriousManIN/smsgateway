<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_light">

        <TextView
            android:id="@+id/tvOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offline_banner"
            android:textColor="@color/white"
            android:background="#D32F2F"
            android:padding="8dp"
            android:visibility="gone"
            android:gravity="center"
            android:fontFamily="@font/google_sans_code"
            android:textSize="12sp" />

        <!-- Top bar — monochrome: hamburger 24dp + smsgateway -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:background="@color/bg_light">

            <ImageView
                android:id="@+id/btnHamburger"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_hamburger"
                app:tint="@color/text_dark"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="smsgateway"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/google_sans_code"
                android:textStyle="bold"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_light" />
    </LinearLayout>

    <!-- Drawer — 280dp white 0dp elevation 1dp stroke #E9ECEF -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:id="@+id/drawerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="smsgateway"
                    android:textSize="18sp"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/google_sans_code"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="12dp" />

            <!-- Menu items — Google Sans Code 14sp, icons 20dp muted #6C757D selected black bold -->
            <LinearLayout
                android:id="@+id/drawerItemHome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_drawer_selected_6"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/drawerIconHome"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="Home" />

                <TextView
                    android:id="@+id/drawerLabelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/google_sans_code"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawerItemGateway"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/drawerIconGateway"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_gateway"
                    android:contentDescription="Gateway" />

                <TextView
                    android:id="@+id/drawerLabelGateway"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gateway"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/google_sans_code"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawerItemLogs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/drawerIconLogs"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_docs"
                    android:contentDescription="Logs" />

                <TextView
                    android:id="@+id/drawerLabelLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logs"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/google_sans_code"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawerItemSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/drawerIconSettings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings" />

                <TextView
                    android:id="@+id/drawerLabelSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/google_sans_code"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="smsgateway v1.0.0"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/google_sans_code"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.drawerlayout.widget.DrawerLayout>
