<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="0dp">

    <!-- Header with Title & Clear Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logs"
                android:textSize="20sp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/google_sans_code"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM &amp; GATEWAY ACTIVITY"
                android:textSize="11sp"
                android:letterSpacing="0.07"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/google_sans_code" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLogs"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Clear All"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            app:strokeColor="@color/border"
            app:cornerRadius="6dp"
            android:fontFamily="@font/google_sans_code"
            android:textStyle="bold"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <!-- Search bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_muted"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="Search logs..."
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_muted"
                android:fontFamily="@font/google_sans_code"
                android:background="@android:color/transparent"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:paddingVertical="0dp" />

            <ImageView
                android:id="@+id/btnSearchClear"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Clear"
                android:visibility="gone"
                android:alpha="0.5" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmptyLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No logs recorded yet."
        android:textColor="@color/text_muted"
        android:fontFamily="@font/google_sans_code"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- Logs RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="24dp" />

</LinearLayout>
