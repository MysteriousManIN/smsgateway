<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Header: app name only, no avatar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="smsgateway"
            android:textSize="20sp"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/google_sans_code"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello, Good Morning!"
            android:textSize="16sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/google_sans_code"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- 2x2 Grid counters — sharp 8dp white cards, no icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="start">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL SENT"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/google_sans_code" />

                    <TextView
                        android:id="@+id/tvSent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="@font/google_sans_code"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvPollInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="poll 15s"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/google_sans_code"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PENDING"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/google_sans_code" />

                    <TextView
                        android:id="@+id/tvPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="28sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="@font/google_sans_code"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="next poll 15s"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/google_sans_code"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GATEWAYS"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/google_sans_code" />

                    <TextView
                        android:id="@+id/tvGatewaysCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="@font/google_sans_code"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvGatewaysSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="active"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/google_sans_code" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FAILED"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/google_sans_code" />

                    <TextView
                        android:id="@+id/tvFailed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="@font/google_sans_code"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvActivitySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sent: 0"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/google_sans_code"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Legacy hidden views for code compat — ponytail: keep ids but gone -->
        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvLastPoll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvWelcomeSub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvGatewayCountActive"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:orientation="horizontal" />
        <Spinner
            android:id="@+id/spinnerGateways"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTestPhone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTestMessage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleService"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestSend"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/progressService"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
